<% content_for :title, "Maraton Kota 2026" %>

<section class="space-y-8">
  <header class="space-y-2">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Maraton Kota 2026</h1>
    <p class="text-slate-600">Minggu, 12 Oktober 2026 · Alun-alun Kota · Start 06.00 WIB</p>
  </header>

  <div class="grid gap-4 sm:grid-cols-2">
    <% @categories.each do |category| %>
      <article class="flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="text-xl font-semibold"><%= category.name %></h2>
          <p class="text-lg font-medium text-slate-700">
            <%= number_to_currency(category.price, unit: "Rp", precision: 0, delimiter: ".", format: "%u%n") %>
          </p>
        </div>

        <% if category.full? %>
          <p class="mt-4 inline-flex w-fit rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-500">
            Kuota penuh
          </p>
        <% else %>
          <p class="mt-2 text-sm text-slate-600">
            Sisa kuota <span class="font-semibold text-slate-900"><%= category.remaining_quota %></span>
            dari <%= category.quota %>
          </p>

          <%= link_to "Daftar #{category.name}",
                new_registration_path(category_id: category.id),
                class: "mt-4 inline-flex w-full items-center justify-center rounded-lg bg-slate-900 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-700" %>
        <% end %>
      </article>
    <% end %>
  </div>
</section>
