<% content_for :title, "Maraton Kota 2026" %>

<section class="-mx-4 -mt-8 mb-10 bg-ink px-4 py-14 text-white sm:px-8">
  <p class="text-xs font-bold uppercase tracking-[0.3em] text-volt">Minggu, 12 Oktober 2026</p>

  <h1 class="mt-4 font-display text-5xl uppercase leading-[0.9] tracking-tight sm:text-7xl">
    Maraton<br>Kota 2026
  </h1>

  <p class="mt-5 max-w-lg text-white/70">
    Lari pagi bareng ratusan pelari kota, menyusuri jalan yang ditutup khusus untuk kita.
    Pilih jarakmu, daftar sekarang, sisanya tinggal latihan.
  </p>

  <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-white/15 bg-white/15 sm:grid-cols-3">
    <div class="bg-ink p-4">
      <dt class="text-xs uppercase tracking-widest text-white/50">Start</dt>
      <dd class="mt-1 font-display text-xl">06.00 WIB</dd>
    </div>
    <div class="bg-ink p-4">
      <dt class="text-xs uppercase tracking-widest text-white/50">Titik kumpul</dt>
      <dd class="mt-1 font-display text-xl">Alun-alun</dd>
    </div>
    <div class="col-span-2 bg-ink p-4 sm:col-span-1">
      <dt class="text-xs uppercase tracking-widest text-white/50">Kategori</dt>
      <dd class="mt-1 font-display text-xl"><%= @categories.size %> jarak</dd>
    </div>
  </dl>
</section>

<section class="space-y-5">
  <h2 class="font-display text-2xl uppercase tracking-tight">Pilih jarakmu</h2>

  <div class="grid gap-5 sm:grid-cols-2">
    <% @categories.each do |category| %>
      <article class="flex flex-col rounded-2xl border-2 border-ink bg-white p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="font-display text-5xl uppercase leading-none tracking-tight"><%= category.name %></h3>
            <p class="mt-2 text-xs uppercase tracking-[0.2em] text-slate-500">Kategori lomba</p>
          </div>

          <p class="whitespace-nowrap rounded-full bg-ink px-3 py-1.5 text-sm font-bold text-white">
            <%= number_to_currency(category.price, unit: "Rp", precision: 0, delimiter: ".", format: "%u%n") %>
          </p>
        </div>

        <div class="mt-6">
          <div class="h-2.5 w-full overflow-hidden rounded-full bg-slate-200">
            <div class="h-full rounded-full <%= category.full? ? "bg-slate-400" : "bg-volt" %>"
                 style="width: <%= category.filled_percentage %>%"></div>
          </div>

          <% if category.full? %>
            <p class="mt-3 text-sm font-bold uppercase tracking-widest text-slate-500">Kuota penuh</p>
          <% else %>
            <p class="mt-3 text-sm text-slate-600">
              Sisa <span class="font-bold text-ink"><%= category.remaining_quota %></span> slot
              dari <%= category.quota %>
            </p>
          <% end %>
        </div>

        <% unless category.full? %>
          <%= link_to "Daftar #{category.name}",
                new_registration_path(category_id: category.id),
                class: "mt-6 block rounded-xl bg-volt px-4 py-4 text-center font-display text-sm uppercase tracking-[0.15em] text-ink hover:bg-ink hover:text-volt" %>
        <% end %>
      </article>
    <% end %>
  </div>
</section>

<%# Pintu masuk panitia. Peserta tidak butuh akun, jadi hanya panitia yang punya
    kata sandi — dan hanya bagian ini yang meminta orang masuk. %>
<section class="mt-12 rounded-2xl bg-ink p-6 text-white sm:flex sm:items-center sm:justify-between sm:gap-8">
  <div>
    <p class="text-xs font-bold uppercase tracking-[0.3em] text-volt">Khusus panitia</p>
    <h2 class="mt-2 font-display text-2xl uppercase tracking-tight">Kelola pendaftaran</h2>
    <p class="mt-3 max-w-md text-sm text-white/70">
      Masuk dengan kata sandi panitia untuk melihat daftar pendaftar, menandai
      pembayaran yang sudah masuk, dan menghapus pendaftaran yang batal.
    </p>
  </div>

  <% if admin_signed_in? %>
    <%= link_to "Buka panel panitia", admin_registrations_path,
          class: "mt-6 block rounded-xl bg-volt px-6 py-4 text-center font-display text-sm uppercase tracking-[0.15em] text-ink hover:bg-white sm:mt-0 sm:shrink-0" %>
  <% else %>
    <%= link_to "Login panitia", login_path,
          class: "mt-6 block rounded-xl bg-volt px-6 py-4 text-center font-display text-sm uppercase tracking-[0.15em] text-ink hover:bg-white sm:mt-0 sm:shrink-0" %>
  <% end %>
</section>
