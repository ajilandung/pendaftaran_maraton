<% content_for :title, "Cek Status Pendaftaran" %>

<section class="space-y-6">
  <header>
    <p class="text-xs font-bold uppercase tracking-[0.3em] text-slate-500">Maraton Kota 2026</p>
    <h1 class="mt-3 font-display text-4xl uppercase leading-none tracking-tight sm:text-5xl">Cek<br>status</h1>
    <p class="mt-4 text-slate-600">Masukkan alamat email yang kamu pakai saat mendaftar.</p>
  </header>

  <%= form_with url: status_path, method: :get, class: "space-y-5 rounded-2xl border-2 border-ink bg-white p-6" do |form| %>
    <div>
      <%= form.label :email, "Alamat email", class: "block text-xs font-bold uppercase tracking-[0.15em] text-slate-500" %>
      <%= form.email_field :email, value: @email, autocomplete: "email",
            class: "mt-2 block w-full rounded-xl border-2 border-slate-200 px-4 py-3.5 text-base focus:border-ink focus:outline-none" %>
    </div>

    <%= form.submit "Cek status",
          class: "w-full cursor-pointer rounded-xl bg-ink px-4 py-4 font-display text-sm uppercase tracking-[0.15em] text-volt hover:bg-ink-soft" %>
  <% end %>

  <% if @searched %>
    <% if @registration %>
      <div class="overflow-hidden rounded-2xl border-4 border-ink bg-white">
        <div class="race-tape h-3"></div>

        <div class="p-8 text-center">
          <p class="text-xs font-bold uppercase tracking-[0.3em] text-slate-500">Nomor pendaftaran</p>
          <p class="mt-2 font-display text-6xl leading-none tracking-tight">#<%= @registration.id %></p>
          <p class="mt-4 font-display text-xl uppercase tracking-wide"><%= @registration.name %></p>
          <p class="mt-1 text-sm uppercase tracking-[0.2em] text-slate-500"><%= @registration.category.name %></p>
        </div>

        <div class="border-t-2 border-dashed border-slate-300 px-8 py-5 text-center
                    <%= @registration.paid? ? "bg-volt" : "bg-slate-50" %>">
          <p class="text-xs uppercase tracking-widest text-slate-600">Pembayaran</p>
          <p class="mt-1 font-display text-2xl uppercase">
            <%= @registration.paid? ? "Lunas" : "Belum lunas" %>
          </p>

          <% unless @registration.paid? %>
            <p class="mt-3 text-sm text-slate-600">
              Pembayaranmu belum tercatat panitia. Kalau sudah transfer, tunggu sampai panitia memeriksanya.
            </p>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="rounded-2xl border-2 border-dashed border-slate-300 bg-white p-6">
        <p class="font-display text-lg uppercase tracking-wide">Tidak ada pendaftaran</p>
        <p class="mt-2 text-slate-600">
          Tidak ada pendaftaran dengan alamat email tersebut. Periksa lagi ejaannya, atau daftar lebih dulu
          dari <%= link_to "halaman utama", root_path, class: "font-bold underline" %>.
        </p>
      </div>
    <% end %>
  <% end %>
</section>
