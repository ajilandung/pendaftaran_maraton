<% content_for :title, "Cek Status Pendaftaran" %>

<section class="space-y-6">
  <header class="space-y-2">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Cek status pendaftaran</h1>
    <p class="text-slate-600">Masukkan alamat email yang Anda pakai saat mendaftar.</p>
  </header>

  <%= form_with url: status_path, method: :get, class: "space-y-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm" do |form| %>
    <div>
      <%= form.label :email, "Alamat email", class: "block text-sm font-medium" %>
      <%= form.email_field :email, value: @email, autocomplete: "email",
            class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
    </div>

    <%= form.submit "Cek status",
          class: "w-full cursor-pointer rounded-lg bg-slate-900 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-700" %>
  <% end %>

  <% if @searched %>
    <% if @registration %>
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm text-slate-500">Nomor pendaftaran</p>
        <p class="text-3xl font-bold tracking-tight">#<%= @registration.id %></p>

        <dl class="mt-5 space-y-2 border-t border-slate-100 pt-5 text-sm">
          <div class="flex justify-between gap-3">
            <dt class="text-slate-500">Nama</dt>
            <dd class="font-medium"><%= @registration.name %></dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-slate-500">Kategori</dt>
            <dd class="font-medium"><%= @registration.category.name %></dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-slate-500">Pembayaran</dt>
            <dd class="font-medium">
              <% if @registration.paid? %>
                <span class="text-emerald-700">Lunas</span>
              <% else %>
                <span class="text-amber-700">Belum lunas</span>
              <% end %>
            </dd>
          </div>
        </dl>

        <% unless @registration.paid? %>
          <p class="mt-4 border-t border-slate-100 pt-4 text-sm text-slate-600">
            Pembayaran Anda belum tercatat panitia. Kalau sudah transfer, tunggu sampai panitia memeriksanya.
          </p>
        <% end %>
      </div>
    <% else %>
      <p class="rounded-xl border border-slate-200 bg-white p-5 text-slate-600">
        Tidak ada pendaftaran dengan alamat email tersebut. Periksa lagi ejaannya, atau daftar lebih dulu
        dari <%= link_to "halaman utama", root_path, class: "font-medium underline" %>.
      </p>
    <% end %>
  <% end %>
</section>
