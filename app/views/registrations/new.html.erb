<% content_for :title, "Formulir Pendaftaran" %>

<section class="space-y-6">
  <header>
    <p class="text-xs font-bold uppercase tracking-[0.3em] text-slate-500">Maraton Kota 2026</p>
    <h1 class="mt-3 font-display text-4xl uppercase leading-none tracking-tight sm:text-5xl">Daftar<br>sekarang</h1>
    <p class="mt-4 text-slate-600">Isi sekali, tanpa membuat akun. Butuh kurang dari satu menit.</p>
  </header>

  <% if @available_categories.empty? %>
    <p class="rounded-2xl border-2 border-ink bg-white p-6 font-bold uppercase tracking-widest">
      Semua kategori sudah penuh. Pendaftaran ditutup.
    </p>
  <% else %>
    <%= form_with model: @registration, class: "space-y-6 rounded-2xl border-2 border-ink bg-white p-6" do |form| %>
      <div>
        <%= form.label :category_id, "Kategori lomba", class: "block text-xs font-bold uppercase tracking-[0.15em] text-slate-500" %>
        <%= form.collection_select :category_id, @available_categories, :id, :name,
              { prompt: "Pilih jarak" },
              class: "mt-2 block w-full rounded-xl border-2 border-slate-200 bg-white px-4 py-3.5 text-base focus:border-ink focus:outline-none" %>
        <%= render "shared/field_error", errors: @registration.errors[:category] %>
      </div>

      <div>
        <%= form.label :name, "Nama lengkap", class: "block text-xs font-bold uppercase tracking-[0.15em] text-slate-500" %>
        <%= form.text_field :name, autocomplete: "name",
              class: "mt-2 block w-full rounded-xl border-2 border-slate-200 px-4 py-3.5 text-base focus:border-ink focus:outline-none" %>
        <%= render "shared/field_error", errors: @registration.errors[:name] %>
      </div>

      <div>
        <%= form.label :email, "Alamat email", class: "block text-xs font-bold uppercase tracking-[0.15em] text-slate-500" %>
        <%= form.email_field :email, autocomplete: "email",
              class: "mt-2 block w-full rounded-xl border-2 border-slate-200 px-4 py-3.5 text-base focus:border-ink focus:outline-none" %>
        <p class="mt-2 text-sm text-slate-500">Dipakai untuk mengecek status pendaftaran nanti.</p>
        <%= render "shared/field_error", errors: @registration.errors[:email] %>
      </div>

      <div>
        <%= form.label :phone, "Nomor ponsel", class: "block text-xs font-bold uppercase tracking-[0.15em] text-slate-500" %>
        <%= form.telephone_field :phone, autocomplete: "tel",
              class: "mt-2 block w-full rounded-xl border-2 border-slate-200 px-4 py-3.5 text-base focus:border-ink focus:outline-none" %>
        <%= render "shared/field_error", errors: @registration.errors[:phone] %>
      </div>

      <div>
        <%= form.label :jersey_size, "Ukuran jersey", class: "block text-xs font-bold uppercase tracking-[0.15em] text-slate-500" %>
        <%= form.select :jersey_size, Registration::JERSEY_SIZES,
              { prompt: "Pilih ukuran" },
              class: "mt-2 block w-full rounded-xl border-2 border-slate-200 bg-white px-4 py-3.5 text-base focus:border-ink focus:outline-none" %>
        <%= render "shared/field_error", errors: @registration.errors[:jersey_size] %>
      </div>

      <%= form.submit "Kirim pendaftaran",
            class: "w-full cursor-pointer rounded-xl bg-ink px-4 py-4 font-display text-sm uppercase tracking-[0.15em] text-volt hover:bg-ink-soft" %>
    <% end %>
  <% end %>
</section>
