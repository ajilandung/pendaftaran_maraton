<% content_for :title, "Formulir Pendaftaran" %>

<section class="space-y-6">
  <header class="space-y-2">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Formulir pendaftaran</h1>
    <p class="text-slate-600">Isi data di bawah ini. Anda tidak perlu membuat akun.</p>
  </header>

  <% if @available_categories.empty? %>
    <p class="rounded-lg border border-slate-200 bg-white p-5 text-slate-600">
      Semua kategori sudah penuh. Pendaftaran ditutup.
    </p>
  <% else %>
    <%= form_with model: @registration, class: "space-y-5 rounded-xl border border-slate-200 bg-white p-5 shadow-sm" do |form| %>
      <div>
        <%= form.label :category_id, "Kategori lomba", class: "block text-sm font-medium" %>
        <%= form.collection_select :category_id, @available_categories, :id, :name,
              { prompt: "Pilih kategori" },
              class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
        <%= render "shared/field_error", errors: @registration.errors[:category] %>
      </div>

      <div>
        <%= form.label :name, "Nama lengkap", class: "block text-sm font-medium" %>
        <%= form.text_field :name, autocomplete: "name",
              class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
        <%= render "shared/field_error", errors: @registration.errors[:name] %>
      </div>

      <div>
        <%= form.label :email, "Alamat email", class: "block text-sm font-medium" %>
        <%= form.email_field :email, autocomplete: "email",
              class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
        <p class="mt-1 text-sm text-slate-500">Dipakai untuk mengecek status pendaftaran nanti.</p>
        <%= render "shared/field_error", errors: @registration.errors[:email] %>
      </div>

      <div>
        <%= form.label :phone, "Nomor ponsel", class: "block text-sm font-medium" %>
        <%= form.telephone_field :phone, autocomplete: "tel",
              class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
        <%= render "shared/field_error", errors: @registration.errors[:phone] %>
      </div>

      <div>
        <%= form.label :jersey_size, "Ukuran jersey", class: "block text-sm font-medium" %>
        <%= form.select :jersey_size, Registration::JERSEY_SIZES,
              { prompt: "Pilih ukuran" },
              class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
        <%= render "shared/field_error", errors: @registration.errors[:jersey_size] %>
      </div>

      <%= form.submit "Kirim pendaftaran",
            class: "w-full cursor-pointer rounded-lg bg-slate-900 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-700" %>
    <% end %>
  <% end %>
</section>
