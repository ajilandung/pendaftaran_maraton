<% content_for :title, "Pendaftaran Berhasil" %>

<section class="space-y-6">
  <header class="space-y-2">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Pendaftaran berhasil</h1>
    <p class="text-slate-600">Simpan nomor pendaftaran Anda. Nomor ini yang ditanyakan panitia.</p>
  </header>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-sm text-slate-500">Nomor pendaftaran</p>
    <p class="text-4xl font-bold tracking-tight">#<%= @registration.id %></p>

    <dl class="mt-5 space-y-2 border-t border-slate-100 pt-5 text-sm">
      <div class="flex justify-between gap-3">
        <dt class="text-slate-500">Nama</dt>
        <dd class="font-medium"><%= @registration.name %></dd>
      </div>
      <div class="flex justify-between gap-3">
        <dt class="text-slate-500">Kategori</dt>
        <dd class="font-medium"><%= @registration.category.name %></dd>
      </div>
      <div class="flex justify-between gap-3">
        <dt class="text-slate-500">Status</dt>
        <dd class="font-medium"><%= @registration.paid? ? "Lunas" : "Belum lunas" %></dd>
      </div>
    </dl>
  </div>

  <div class="rounded-xl border border-amber-200 bg-amber-50 p-5">
    <h2 class="font-semibold">Cara membayar</h2>
    <p class="mt-2 text-sm text-slate-700">
      Transfer sebesar
      <span class="font-semibold">
        <%= number_to_currency(@registration.category.price, unit: "Rp", precision: 0, delimiter: ".", format: "%u%n") %>
      </span>
      ke rekening di bawah ini, lalu cantumkan nomor pendaftaran
      <span class="font-semibold">#<%= @registration.id %></span> pada berita transfer.
    </p>
    <p class="mt-3 text-sm text-slate-700">
      Bank Contoh · <span class="font-semibold">123-456-7890</span> · a.n. Panitia Maraton Kota
    </p>
    <p class="mt-3 text-xs text-slate-500">
      Rekening di atas masih contoh. Ganti di berkas tampilan halaman ini sebelum dipakai sungguhan.
    </p>
  </div>

  <%= link_to "Kembali ke halaman utama", root_path, class: "inline-block text-sm font-medium text-slate-700 underline" %>
</section>
