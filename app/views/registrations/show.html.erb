<% content_for :title, "Pendaftaran Berhasil" %>

<section class="space-y-8">
  <header class="text-center">
    <p class="text-xs font-bold uppercase tracking-[0.3em] text-slate-500">Sampai jumpa di garis start</p>
    <h1 class="mt-3 font-display text-4xl uppercase leading-none tracking-tight sm:text-5xl">Kamu terdaftar</h1>
  </header>

  <div class="overflow-hidden rounded-2xl border-4 border-ink bg-white">
    <div class="race-tape h-3"></div>

    <div class="p-8 text-center">
      <p class="text-xs font-bold uppercase tracking-[0.3em] text-slate-500">Nomor pendaftaran</p>
      <p class="mt-2 font-display text-7xl leading-none tracking-tight sm:text-8xl">
        <%= @registration.id %>
      </p>
      <p class="mt-4 font-display text-xl uppercase tracking-wide"><%= @registration.name %></p>
      <p class="mt-1 text-sm uppercase tracking-[0.2em] text-slate-500">
        <%= @registration.category.name %> · Jersey <%= @registration.jersey_size %>
      </p>
    </div>

    <div class="border-t-2 border-dashed border-slate-300 bg-slate-50 px-8 py-4 text-center">
      <p class="text-xs uppercase tracking-widest text-slate-500">Status pembayaran</p>
      <p class="mt-1 font-display text-lg uppercase">
        <%= @registration.paid? ? "Lunas" : "Belum lunas" %>
      </p>
    </div>
  </div>

  <div class="rounded-2xl border-2 border-ink bg-white p-6">
    <h2 class="font-display text-lg uppercase tracking-wide">Cara membayar</h2>
    <p class="mt-3 text-slate-700">
      Transfer
      <span class="font-bold">
        <%= number_to_currency(@registration.category.price, unit: "Rp", precision: 0, delimiter: ".", format: "%u%n") %>
      </span>
      ke rekening di bawah, lalu tulis nomor
      <span class="font-bold">#<%= @registration.id %></span> pada berita transfer.
    </p>

    <p class="mt-4 rounded-xl bg-track px-4 py-3 font-display text-lg tracking-wide">
      Bank Contoh · 123-456-7890
    </p>
    <p class="mt-2 text-sm text-slate-600">a.n. Panitia Maraton Kota</p>

    <p class="mt-4 text-xs text-slate-500">
      Rekening di atas masih contoh. Ganti di berkas tampilan halaman ini sebelum dipakai sungguhan.
    </p>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= link_to "Cek status pendaftaran", status_path,
          class: "rounded-xl bg-volt px-5 py-3 font-display text-sm uppercase tracking-[0.15em] text-ink hover:bg-ink hover:text-volt" %>
    <%= link_to "Kembali ke halaman utama", root_path,
          class: "rounded-xl border-2 border-ink px-5 py-3 font-display text-sm uppercase tracking-[0.15em] hover:bg-ink hover:text-white" %>
  </div>
</section>
