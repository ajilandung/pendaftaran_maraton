<% content_for :title, "Panel Panitia" %>

<section class="space-y-6">
  <header class="space-y-2">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Panel panitia</h1>
    <p class="text-slate-600"><%= @registrations.size %> pendaftar tercatat.</p>
  </header>

  <div class="grid gap-3 sm:grid-cols-3">
    <% @categories.each do |category| %>
      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <p class="text-sm text-slate-500"><%= category.name %></p>
        <p class="text-xl font-semibold">
          Sisa <%= category.remaining_quota %><span class="text-sm font-normal text-slate-500"> / <%= category.quota %></span>
        </p>
      </div>
    <% end %>
  </div>

  <% if @registrations.empty? %>
    <p class="rounded-xl border border-slate-200 bg-white p-5 text-slate-600">Belum ada pendaftar.</p>
  <% else %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="border-b border-slate-200 text-slate-500">
          <tr>
            <th class="whitespace-nowrap px-4 py-3 font-medium">No</th>
            <th class="whitespace-nowrap px-4 py-3 font-medium">Nama</th>
            <th class="whitespace-nowrap px-4 py-3 font-medium">Kontak</th>
            <th class="whitespace-nowrap px-4 py-3 font-medium">Kategori</th>
            <th class="whitespace-nowrap px-4 py-3 font-medium">Jersey</th>
            <th class="whitespace-nowrap px-4 py-3 font-medium">Status</th>
            <th class="whitespace-nowrap px-4 py-3 font-medium">Tindakan</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @registrations.each do |registration| %>
            <tr>
              <td class="whitespace-nowrap px-4 py-3 font-medium">#<%= registration.id %></td>
              <td class="whitespace-nowrap px-4 py-3"><%= registration.name %></td>
              <td class="whitespace-nowrap px-4 py-3 text-slate-500">
                <%= registration.email %><br>
                <%= registration.phone %>
              </td>
              <td class="whitespace-nowrap px-4 py-3"><%= registration.category.name %></td>
              <td class="whitespace-nowrap px-4 py-3"><%= registration.jersey_size %></td>
              <td class="whitespace-nowrap px-4 py-3">
                <% if registration.paid? %>
                  <span class="rounded-full bg-emerald-100 px-2 py-1 text-xs font-medium text-emerald-800">Lunas</span>
                <% else %>
                  <span class="rounded-full bg-amber-100 px-2 py-1 text-xs font-medium text-amber-800">Belum lunas</span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-4 py-3">
                <div class="flex items-center gap-3">
                  <% if registration.paid? %>
                    <%= button_to "Batalkan lunas", mark_unpaid_admin_registration_path(registration),
                          method: :patch, class: "cursor-pointer font-medium text-slate-700 underline" %>
                  <% else %>
                    <%= button_to "Tandai lunas", mark_paid_admin_registration_path(registration),
                          method: :patch, class: "cursor-pointer font-medium text-emerald-700 underline" %>
                  <% end %>

                  <%= button_to "Hapus", admin_registration_path(registration),
                        method: :delete,
                        form: { data: { turbo_confirm: "Hapus pendaftaran #{registration.name}? Slotnya akan kembali tersedia." } },
                        class: "cursor-pointer font-medium text-red-700 underline" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
