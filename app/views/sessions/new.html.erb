<% content_for :title, "Login Panitia" %>

<section class="mx-auto max-w-md space-y-6">
  <header>
    <p class="text-xs font-bold uppercase tracking-[0.3em] text-slate-500">Khusus panitia</p>
    <h1 class="mt-3 font-display text-4xl uppercase leading-none tracking-tight sm:text-5xl">Login<br>panitia</h1>
    <p class="mt-4 text-slate-600">
      Masukkan kata sandi panitia. Halaman ini bukan untuk peserta — peserta cukup
      <%= link_to "mengecek status", status_path, class: "font-bold underline" %> dengan alamat email.
    </p>
  </header>

  <%= form_with url: login_path, method: :post, class: "space-y-5 rounded-2xl border-2 border-ink bg-white p-6" do |form| %>
    <div>
      <%= form.label :password, "Kata sandi", class: "block text-xs font-bold uppercase tracking-[0.15em] text-slate-500" %>
      <%= form.password_field :password, autocomplete: "current-password", autofocus: true,
            class: "mt-2 block w-full rounded-xl border-2 border-slate-200 px-4 py-3.5 text-base focus:border-ink focus:outline-none" %>
    </div>

    <%= form.submit "Masuk",
          class: "w-full cursor-pointer rounded-xl bg-ink px-4 py-4 font-display text-sm uppercase tracking-[0.15em] text-volt hover:bg-ink-soft" %>
  <% end %>

  <%= link_to "Kembali ke halaman utama", root_path, class: "inline-block text-sm font-bold underline" %>
</section>
